#!/bin/bash
# Tikkle API 서버 첫 부팅 준비. Terraform이 만든다(infra/terraform/live/server.tf).
# 첫 부팅 때 한 번만 돈다. 비밀값은 넣지 않는다 — 이 내용은 EC2 콘솔과 인스턴스 메타데이터에서 보인다.
# 앱(compose·배포 스크립트·.env)은 여기서 두지 않는다. 배포할 때 그 커밋의 파일을 SSM으로 받는다.
#
# Terraform templatefile 주의: 이 파일에서 Terraform 값은 달러+중괄호 꼴로 들어간다.
# bash 변수는 중괄호 없이 $VAR 로만 쓴다.
set -uo pipefail
exec > >(tee -a /var/log/tikkle-bootstrap.log) 2>&1

DOMAIN="${domain}"
EIP="${eip}"
CERTBOT_EMAIL="${certbot_email}"
APP_DIR="/opt/tikkle"
COMPOSE_VERSION="v2.31.0"

log() { echo "[tikkle-bootstrap] $(date -Is) $*"; }
fail() { log "실패: $*"; exit 1; }

log "시작 (도메인 $DOMAIN, EIP $EIP)"

# 1. 패키지 -------------------------------------------------------------
log "패키지 업데이트"
dnf -y update || fail "dnf update"
log "docker·nginx·dnf-automatic 설치 (git은 설치하지 않는다)"
dnf -y install docker nginx dnf-automatic || fail "dnf install"

# 2. 보안 업데이트 자동 적용 (재부팅은 하지 않는다) ------------------------
sed -i -e 's/^upgrade_type *=.*/upgrade_type = security/' \
       -e 's/^apply_updates *=.*/apply_updates = yes/' /etc/dnf/automatic.conf
systemctl enable --now dnf-automatic.timer

# 3. Docker: 로그 회전 + compose 플러그인 ---------------------------------
mkdir -p /etc/docker
cat > /etc/docker/daemon.json <<'JSON'
{
  "log-driver": "json-file",
  "log-opts": { "max-size": "50m", "max-file": "5" }
}
JSON
systemctl enable --now docker || fail "docker 기동"
usermod -aG docker ec2-user

case "$(uname -m)" in
  aarch64) COMPOSE_ARCH="aarch64" ;;
  x86_64)  COMPOSE_ARCH="x86_64" ;;
  *)       fail "모르는 아키텍처 $(uname -m)" ;;
esac
PLUGIN_DIR="/usr/local/lib/docker/cli-plugins"
mkdir -p "$PLUGIN_DIR"
BASE_URL="https://github.com/docker/compose/releases/download/$COMPOSE_VERSION/docker-compose-linux-$COMPOSE_ARCH"
log "compose 플러그인 $COMPOSE_VERSION ($COMPOSE_ARCH) 받기 + 체크섬 확인"
curl -fsSL "$BASE_URL" -o /tmp/docker-compose || fail "compose 받기"
curl -fsSL "$BASE_URL.sha256" -o /tmp/docker-compose.sha256 || fail "compose 체크섬 받기"
EXPECTED="$(awk '{print $1}' /tmp/docker-compose.sha256)"
ACTUAL="$(sha256sum /tmp/docker-compose | awk '{print $1}')"
[ "$EXPECTED" = "$ACTUAL" ] || fail "compose 체크섬 불일치"
install -m 0755 /tmp/docker-compose "$PLUGIN_DIR/docker-compose"
docker compose version

# 4. 스왑 2GB (JVM이 순간적으로 메모리를 더 쓸 때 OOM을 막는다) --------------
if [ ! -f /swapfile ]; then
  log "스왑 2GB"
  dd if=/dev/zero of=/swapfile bs=1M count=2048 status=none
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# 5. 앱 디렉터리 (배포 때 compose·스크립트·.env가 여기에 온다) ---------------
mkdir -p "$APP_DIR"
chown ec2-user:ec2-user "$APP_DIR"
chmod 750 "$APP_DIR"

# 6. nginx (레포의 infra/nginx/tikkle.conf 그대로) --------------------------
log "nginx 설정"
cat > /etc/nginx/conf.d/tikkle.conf <<'NGINX'
${nginx_conf}
NGINX
nginx -t || fail "nginx 설정 검사"
systemctl enable --now nginx || fail "nginx 기동"

# 7. certbot ---------------------------------------------------------------
log "certbot 설치"
if ! dnf -y install certbot python3-certbot-nginx; then
  log "dnf에 certbot이 없다. 공식 안내대로 venv에 설치한다"
  dnf -y install python3 augeas-libs || fail "python3 설치"
  python3 -m venv /opt/certbot || fail "venv"
  /opt/certbot/bin/pip install --upgrade pip || fail "pip"
  /opt/certbot/bin/pip install certbot certbot-nginx || fail "certbot pip 설치"
  ln -sf /opt/certbot/bin/certbot /usr/bin/certbot
fi

# 갱신: 패키지 타이머가 있으면 쓰고, 없으면 만든다(하루 두 번, 갱신되면 nginx reload).
if systemctl list-unit-files | grep -q '^certbot-renew.timer'; then
  systemctl enable --now certbot-renew.timer
else
  cat > /etc/systemd/system/certbot-renew.service <<'UNIT'
[Unit]
Description=Renew Let's Encrypt certificates

[Service]
Type=oneshot
ExecStart=/usr/bin/certbot renew --quiet --deploy-hook "systemctl reload nginx"
UNIT
  cat > /etc/systemd/system/certbot-renew.timer <<'UNIT'
[Unit]
Description=Renew Let's Encrypt certificates twice a day

[Timer]
OnCalendar=*-*-* 03,15:30:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
UNIT
  systemctl daemon-reload
  systemctl enable --now certbot-renew.timer
fi

# 8. TLS 발급: EIP가 이 서버에 붙고 도메인이 EIP를 가리킬 때까지 기다린다(최대 15분) -----
log "EIP 연결과 DNS를 기다린다"
READY="no"
for i in $(seq 1 90); do
  TOKEN="$(curl -fsS -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' 2>/dev/null || true)"
  MY_IP="$(curl -fsS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/public-ipv4 2>/dev/null || true)"
  DNS_IP="$(getent ahostsv4 "$DOMAIN" | awk 'NR==1{print $1}')"
  if [ "$MY_IP" = "$EIP" ] && [ "$DNS_IP" = "$EIP" ]; then
    READY="yes"
    break
  fi
  sleep 10
done

if [ "$READY" = "yes" ]; then
  log "TLS 인증서 발급 ($DOMAIN)"
  if certbot --nginx -d "$DOMAIN" --non-interactive --agree-tos -m "$CERTBOT_EMAIL" --redirect; then
    log "인증서 발급 완료"
  else
    log "인증서 발급 실패 — 서버는 HTTP로 떠 있다. SSM 세션에서 같은 certbot 명령을 다시 실행할 것"
  fi
else
  log "15분 안에 EIP 연결 또는 DNS가 맞지 않았다 — 인증서는 SSM 세션에서 직접 발급할 것"
fi

log "끝"
date -Is > "$APP_DIR/.bootstrap-done"
